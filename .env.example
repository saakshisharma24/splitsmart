# Copy to .env and fill in. Never commit the real .env.

# Local SQLite by default - zero setup, works offline.
# For Postgres (e.g. Neon/Supabase/Vercel) swap the provider in
# prisma/schema.prisma to "postgresql" and point this at your connection string.
DATABASE_URL="file:./dev.db"

# Signs the session cookie. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-32-random-bytes"

# Optional. Without it, receipt scanning still works: Tesseract reads the image
# locally and a rule-based parser pulls out the line items. With it, the parsed
# result is cleaned up by Claude, which handles messy real-world receipts far better.
ANTHROPIC_API_KEY=""
